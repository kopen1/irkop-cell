{
  "appId": "id.co.irkop.cell",
  "appName": "Iirkop Cell",
  "webDir": "../frontend/dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SQLite": {
      "androidDatabase": "SQLITE"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#488AFF",
      "sound": "beep.wav"
    }
  },
  "android": {
    "buildOptions": {
      "keystorePath": "konter-release.keystore",
      "keystoreAlias": "konter"
    }
  }
}
