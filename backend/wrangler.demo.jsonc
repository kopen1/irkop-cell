{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "konter-demo",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "legacy_env_names": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "irkop-d1-demo",
      "database_id": "ed41aaf2-2b44-4938-9fe9-269931cd5c5c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_TIMEZONE": "Asia/Jakarta",
    "TOKEN_TTL": "2592000"
  },
  "observability": {
    "enabled": true
  }
}
