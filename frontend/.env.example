# Lingkungan Frontend
# Base URL API (Cloudflare Worker Team 1). Kosongkan berarti pakai origin server /api.
# PRODUCTION WAJIB: VITE_API_BASE=/api agar fetch ke /api/auth/login (bukan /auth/login).
VITE_API_BASE=/api

# Target proxy dev untuk /api (opsional, default http://localhost:8787)
VITE_API_PROXY=http://localhost:8787